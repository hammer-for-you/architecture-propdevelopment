        <mxCell id="NzGLxvM38rAgYDI6lwTS-15" value="Аутентификационные данные клиентов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
